---
import '../styles/global.css';
const { title, description = '机场 IP 知识库与机场资料库：比较 IP 类型、线路、节点地区及服务商支持声明。', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://jichangip.xyz').toString();
const nav = [['机场目录','/airports/'],['原生 IP','/native-ip/'],['IP 知识','/ip/'],['AI','/ai/'],['流媒体','/streaming/'],['IP 检测指南','/ip-check/']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}｜机场IP</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content={type}/><meta property="og:site_name" content="机场IP"/><meta property="og:title" content={`${title}｜机场IP`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'机场IP',alternateName:'Jichang IP',url:'https://jichangip.xyz/'})}/></head><body>
<header class="site-header"><div class="wrap bar"><a class="brand" href="/">机场IP <small>Jichang IP</small></a><nav class="nav">{nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav></div></header>
<slot />
<footer class="footer"><div class="wrap footer-grid"><div><strong>机场IP</strong><p>机场IP 是围绕机场节点、出口 IP、原生 IP、住宅 IP、ISP IP、共享 IP、独享 IP、线路架构与网络地区识别建立的中文资料站。</p><p>本站整理服务商套餐、线路、节点地区、IP 类型声明，以及 AI、流媒体、ASN、IP 风控、DNS 泄漏与 WebRTC 等网络知识。</p><p class="meta">相关线路、IP 与平台支持信息部分来自服务商公开资料，不代表本站独立测速或验证。</p></div><div class="link-grid">{[['IP 基础','/ip/'],['原生 IP','/ip/what-is-native-ip/'],['住宅 IP','/ip/what-is-residential-ip/'],['ISP IP','/ip/what-is-isp-ip/'],['数据中心 IP','/ip/datacenter-ip/'],['共享 IP','/ip/what-is-shared-ip/'],['独享 IP','/ip/what-is-dedicated-ip/'],['静态 IP','/ip/what-is-static-ip/'],['IPv4 / IPv6','/ip/ipv4-vs-ipv6/'],['ASN','/ip/what-is-asn/'],['机场目录','/airports/'],['原生 IP 机场','/native-ip/'],['机场出口 IP','/ip/airport-egress-ip/'],['机场共享 IP','/ip/airport-shared-ip/'],['机场 IP 会变化吗','/ip/airport-ip-changes/'],['IEPL','/iepl/'],['IPLC','/iplc/'],['IP 纯净度','/ip/ip-purity/'],['IP 风控','/ip/ip-risk-control/'],['IP 黑名单','/ip/ip-blacklist/'],['DNS 泄漏','/ip/dns-leak/'],['WebRTC 泄漏','/ip/webrtc-leak/'],['IPv6 泄漏','/ip/ipv6-leak/'],['ChatGPT 地区','/ip/why-chatgpt-detects-region/'],['Claude 地区','/ip/claude-region-and-ip/'],['Gemini 地区','/ip/gemini-region-detection/'],['Netflix','/ip/why-netflix-detects-proxy/'],['Disney+','/ip/disney-plus-region/'],['TikTok','/ip/tiktok-ip-region/'],['YouTube','/ip/youtube-region-and-ip/'],['香港节点','/regions/hong-kong/'],['日本节点','/regions/japan/'],['新加坡节点','/regions/singapore/'],['台湾节点','/regions/taiwan/'],['美国节点','/regions/united-states/'],['关于本站','/about/'],['推广声明','/affiliate-disclosure/'],['隐私说明','/privacy/']].map(([label,href]) => <a href={href}>{label}</a>)}</div></div><div class="wrap"><p class="meta">热门关键词：{[['机场IP','/airports/'],['原生IP','/ip/what-is-native-ip/'],['住宅IP','/ip/what-is-residential-ip/'],['ISP IP','/ip/what-is-isp-ip/'],['共享IP','/ip/what-is-shared-ip/'],['独享IP','/ip/what-is-dedicated-ip/'],['IP纯净度','/ip/ip-purity/'],['IP风控','/ip/ip-risk-control/'],['机场出口IP','/ip/airport-egress-ip/'],['ChatGPT机场','/ai/'],['AI机场','/ip/airport-ip-for-ai/'],['Netflix','/streaming/'],['DNS泄漏','/ip/dns-leak/'],['WebRTC','/ip/webrtc-leak/']].map(([label,href],i)=><>{i>0&&' · '}<a href={href}>{label}</a></>)}</p></div></footer>
</body></html>
