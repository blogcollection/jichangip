---
import Base from '../../layouts/Base.astro'; import AirportModule from '../../components/AirportModule.astro'; import { articles, articleBySlug } from '../../lib/articles'; import { related } from '../../lib/data';
export function getStaticPaths(){return articles.map(a=>({params:{slug:a.slug}}))}; const article=articleBySlug(Astro.params.slug!); if(!article) throw new Error('Missing article'); const shown=related(article.airportTerm); const schema={'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,mainEntityOfPage:`https://jichangip.xyz/ip/${article.slug}/`,author:{'@type':'Organization',name:'机场IP'},publisher:{'@type':'Organization',name:'机场IP'}};
---
<Base title={article.title} description={article.description} type="article"><main class="wrap prose"><div class="crumbs"><a href="/">首页</a> / <a href="/ip/">IP 知识</a> / {article.title}</div><article><div class="eyebrow">{article.cluster} · {article.topic}</div><h1>{article.title}</h1><p class="lead">{article.answer}</p>{article.sections.map(([h,p])=><><h2>{h}</h2><p>{p}</p></>)}</article></main><div class="wrap related-airports"><AirportModule airports={shown.slice(0,3)} title="相关机场资料"/></div><main class="wrap prose"><article><h2>相关阅读</h2><p>{article.related.map((slug,i)=>{const a=articleBySlug(slug);return a&&<>{i>0&&' · '}<a href={`/ip/${a.slug}/`}>{a.title}</a></>})}</p><h2>常见问题</h2>{article.faq.map(item=><><h3>{item.q}</h3><p>{item.a}</p></>)}</article></main><script type="application/ld+json" set:html={JSON.stringify(schema)}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:article.faq.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))})}/></Base>
