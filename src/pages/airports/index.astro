---
import Base from '../../layouts/Base.astro'; import AirportCard from '../../components/AirportCard.astro'; import { airports, has, list } from '../../lib/data';
const text=(a:any,...fields:string[])=>fields.map(f=>String(a[f]??'')).join(' ').toLowerCase();
const matches={native:(a:any)=>a.native_ip_declared||/原生\s*ip|native\s*ip/i.test(text(a,'summary','feature_bullets','line_architecture','ip_profile')),iepl:(a:any)=>/iepl/i.test(text(a,'line_architecture','summary','feature_bullets')),iplc:(a:any)=>/iplc/i.test(text(a,'line_architecture','summary','feature_bullets')),chatgpt:(a:any)=>/chatgpt/i.test(text(a,'ai_services_mentioned','unlock_support_from_overview')),netflix:(a:any)=>/netflix/i.test(text(a,'streaming_services_mentioned','unlock_support_from_overview'))};
const filters=[['native','原生 IP 声明'],['iepl','IEPL'],['iplc','IPLC'],['chatgpt','ChatGPT'],['netflix','Netflix'],['hong-kong','香港'],['japan','日本'],['singapore','新加坡'],['taiwan','台湾'],['united-states','美国']] as const;
const attributes=(a:any)=>({native:matches.native(a),iepl:matches.iepl(a),iplc:matches.iplc(a),chatgpt:matches.chatgpt(a),netflix:matches.netflix(a),regions:list(a.node_regions_standardized)});
---
<Base title="机场目录" description="按 IP 声明、线路、地区和服务支持资料浏览机场。"><main class="wrap"><div class="crumbs"><a href="/">首页</a> / 机场目录</div><section><div class="eyebrow">Directory</div><h1>机场资料目录</h1><p class="lead">以下资料来自已导入的服务商与结构化来源。筛选基于明确的资料字段匹配。</p></section><section><div class="filters" id="airport-filters" aria-label="机场资料筛选"><button type="button" aria-pressed="true" data-filter="all">全部</button>{filters.map(([key,label])=><button type="button" aria-pressed="false" data-filter={key}>{label}</button>)}</div><p class="meta" id="filter-count" aria-live="polite">全部 · {airports.length} 个机场</p><div id="airport-list" class="grid">{airports.map(a=>{const attr=attributes(a);return <div class="airport-item" data-native={String(attr.native)} data-iepl={String(attr.iepl)} data-iplc={String(attr.iplc)} data-chatgpt={String(attr.chatgpt)} data-netflix={String(attr.netflix)} data-regions={attr.regions.join(',')}><AirportCard airport={a}/></div>})}</div><div class="empty" id="filter-empty" hidden>暂无符合当前条件的机场资料。 <button type="button" id="show-all">查看全部机场</button></div>{!airports.length&&<p class="empty">暂无机场资料。导入数据后，此目录会自动生成。</p>}</section></main><script>const labels={all:'全部',native:'原生 IP 声明',iepl:'IEPL',iplc:'IPLC',chatgpt:'ChatGPT',netflix:'Netflix','hong-kong':'香港',japan:'日本',singapore:'新加坡',taiwan:'台湾','united-states':'美国'};const regionMap={'hong-kong':'Hong Kong',japan:'Japan',singapore:'Singapore',taiwan:'Taiwan','united-states':'United States'};const buttons=[...document.querySelectorAll('#airport-filters button')];const items=[...document.querySelectorAll('.airport-item')];const count=document.querySelector('#filter-count');const empty=document.querySelector('#filter-empty');function applyFilter(key){let visible=0;items.forEach(item=>{const match=key==='all'||(regionMap[key]?item.dataset.regions.split(',').includes(regionMap[key]):item.dataset[key]==='true');item.hidden=!match;if(match)visible++});buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===key)));count.textContent=`${labels[key]} · ${visible} 个机场`;empty.hidden=visible!==0}buttons.forEach(button=>button.addEventListener('click',()=>applyFilter(button.dataset.filter)));document.querySelector('#show-all')?.addEventListener('click',()=>applyFilter('all'));</script></Base>
