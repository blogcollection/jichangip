---
import Base from '../../layouts/Base.astro'; import { airports, clean, displayDate, price, readable, regions, verificationLabel } from '../../lib/data';
export function getStaticPaths(){return airports.map(a=>({params:{slug:a.slug},props:{airport:a}}))}
const { airport }=Astro.props; const nodeRegions=regions(airport.node_regions_standardized); const tags=[...(airport.native_ip_declared?['服务商声明原生 IP']:[]),...(airport.line_architecture?[readable(airport.line_architecture).slice(0,28)]:[]),...nodeRegions.slice(0,2),...readable(airport.ai_services_mentioned).split(/[、|]/).filter(x=>x!=='暂无资料').slice(0,1),...readable(airport.streaming_services_mentioned).split(/[、|]/).filter(x=>x!=='暂无资料').slice(0,1)].slice(0,5);
const suitable=[airport.ai_services_mentioned&&'适合关注 AI 服务资料的用户',airport.streaming_services_mentioned&&'适合关注流媒体支持声明的用户',airport.device_or_usage_limits&&'适合多设备使用需求',airport.discounts_or_coupon&&'适合比较长期套餐优惠'].filter(Boolean); const rows=[['最低月付价格',price(airport)],['线路架构',readable(airport.line_architecture)],['协议',readable(airport.protocols)],['节点地区',nodeRegions.join('、')||'暂无资料'],['客户端',readable(airport.client_support)],['平台',readable(airport.platforms)],['设备 / 使用限制',readable(airport.device_or_usage_limits)],['免费试用',readable(airport.free_trial)],['退款说明',readable(airport.refund_policy)],['优惠',readable(airport.discounts_or_coupon)],['AI 服务声明',readable(airport.ai_services_mentioned)],['流媒体声明',readable(airport.streaming_services_mentioned)],['资料最后检查',displayDate(airport.last_checked_at)],['验证状态',verificationLabel(airport.verification_status)]];
const crumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:'https://jichangip.xyz/'},{'@type':'ListItem',position:2,name:'机场目录',item:'https://jichangip.xyz/airports/'},{'@type':'ListItem',position:3,name:airport.service_name,item:`https://jichangip.xyz/airports/${airport.slug}/`}]} ;
---
<Base title={`${airport.service_name} 机场资料`} description={clean(airport.summary)}><main class="wrap airport-detail"><div class="crumbs"><a href="/">首页</a> / <a href="/airports/">机场目录</a> / {airport.service_name}</div><section class="airport-hero"><div class="eyebrow">机场资料 · 服务商信息</div><h1>{airport.service_name}</h1>{airport.aliases&&<p class="meta">别名：{airport.aliases}</p>}<p class="lead">{clean(airport.summary)}</p><div class="hero-facts"><div><b>最低价格</b><strong>{price(airport)}</strong></div><div><b>资料最后检查</b><span>{displayDate(airport.last_checked_at)}</span></div></div><div class="tags">{tags.map(tag=><span class="tag">{tag}</span>)}</div><div class="actions">{airport.affiliate_url&&<a class="button" href={airport.affiliate_url} target="_blank" rel="sponsored noopener noreferrer">查看套餐</a>}{airport.official_url&&<a class="button alt" href={airport.official_url} target="_blank" rel="noopener noreferrer">访问官网</a>}</div><p class="meta">部分链接可能包含推广 / 联盟参数。</p></section><section><div class="decision-grid"><div><h2>这家机场适合谁</h2>{suitable.length?<ul>{suitable.map(item=><li>{item}</li>)}</ul>:<p>暂无足够的结构化资料用于概括适用场景。</p>}</div><div><h2>注意事项</h2><p>IP、线路和服务支持信息可能来自服务商资料，不等同于本站独立测试。</p></div></div></section><section><h2>节点地区</h2>{nodeRegions.length?<><div class="tags node-tags">{nodeRegions.slice(0,8).map(region=><span class="tag">{region}</span>)}</div>{nodeRegions.length>8&&<p class="meta">等 {nodeRegions.length} 个地区</p>}</>:<p>暂无资料</p>}</section><section><h2>用途适配</h2><div class="profile"><div><b>AI 服务</b>{readable(airport.ai_services_mentioned)}</div><div><b>流媒体</b>{readable(airport.streaming_services_mentioned)}</div><div><b>线路类型</b>{readable(airport.line_architecture)}</div><div><b>IP 类型声明</b>{airport.native_ip_declared?'服务商声明提供原生 IP':'暂无资料'}</div></div></section><section><h2>详细结构化资料</h2><table class="data-table"><tbody>{rows.map(([k,v])=><tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table></section><section class="prose"><h2>购买建议</h2>{readable(airport.purchase_advice)==='暂无资料'?<p>暂无资料</p>:<ul>{readable(airport.purchase_advice).split(/[|｜]/).map(item=><li>{item.trim()}</li>)}</ul>}</section></main><script type="application/ld+json" set:html={JSON.stringify(crumbs)}/></Base>
